# DOMINION: copy to .env only if using a compatible env loader; otherwise export in your shell.
DOMINION_HOST=127.0.0.1
DOMINION_PORT=4317
DOMINION_DATA=./runtime
DOMINION_WORKSPACE=./workspace
# Required before binding beyond loopback:
# DOMINION_ADMIN_TOKEN=long-random-token
# Optional SearXNG self-hosted URL (used by the web_search tool)
# SEARXNG_URL=http://127.0.0.1:8080
# Optional OAuth apps; callback URL http://127.0.0.1:4317/api/oauth/<provider>/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
