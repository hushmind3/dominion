# Copy these public build-time settings into web/.env.local when testing sub3.
# Do NOT use the main production gateway; provision an isolated staging Worker.
# Secrets, provider API keys and payment signing keys NEVER belong in Vite env.
VITE_DOMINION_CLOUD_URL=https://dominion-cloud-sub3.YOUR_SUBDOMAIN.workers.dev
VITE_DOMINION_GOOGLE_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
