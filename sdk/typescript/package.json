{
  "name": "@dominion/sdk",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Typed TypeScript SDK for the existing Dominion Rust agent engine",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
