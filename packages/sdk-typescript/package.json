{
  "name": "@hushmind3/dominion-sdk",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "TypeScript SDK for Dominion native Rust agent execution",
  "license": "MIT",
  "repository": {"type":"git","url":"https://github.com/hushmind3/dominion.git","directory":"packages/sdk-typescript"},
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
